# 🛡️ SecOps Hardening Configuration
# Ref: .agents/rules/secops.md

# Bloqueo de scripts post-instalación para evitar ejecución de código malicioso
ignore-scripts=true

# Cuarentena de 48 horas para paquetes recién publicados (Supply Chain Defense)
minimum-release-age=2880

# Verificación estricta de la integridad del store de pnpm
verify-store-integrity=true

# Forzar el uso de pnpm y evitar npm/yarn
engine-strict=true
